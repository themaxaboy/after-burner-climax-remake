{
  "name": "after-burner-climax-remake",
  "private": true,
  "version": "0.1.0",
  "description": "After Burner Climax web remake (fan project) - three.js arcade flight shooter",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
