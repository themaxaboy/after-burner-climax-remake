  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
